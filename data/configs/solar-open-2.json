{
    "model_type": "solar_open2",
    "architectures": [
        "SolarOpen2ForCausalLM"
    ],
    "pad_token_id": 2,
    "bos_token_id": 1,
    "eos_token_id": 2,
    "partial_rotary_factor": 1.0,
    "linear_attn_config": {
        "short_conv_kernel_size": 4,
        "head_dim": 128,
        "num_heads": 64,
        "num_kv_heads": null
    },
